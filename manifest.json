{
  "manifest_version": 3,
  "name": "Backtrack Development",
  "version": "0.2.0",
  "description": "Local development build for safe cross-tab back navigation research in Chromium browsers.",
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "src/content/gesture-debug.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "ISOLATED"
    }
  ]
}
